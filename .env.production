# ENVIRONMENT
DEBUG=false
ENVIRONMENT=production

# DATABASE
DB_HOST=prod-db.example.com
DB_PORT=5432
DB_USER=med_user_prod
DB_PASSWORD=some_pass
DB_NAME=med_db_prod
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20

# REDIS
REDIS_HOST=prod-redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_SECURELY

# APPLICATION
SECRET_KEY=some-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# FILE UPLOAD
MAX_FILE_SIZE_MB=100
UPLOAD_DIRECTORY=/var/lib/med-lab/uploads

# OCR
OCR_TIMEOUT_SECONDS=60
OCR_RETRY_ATTEMPTS=3

# EXTERNAL APIs
LLM_PROVIDER=openai
LLM_API_KEY=sk-some-key
LLM_MODEL=gpt-4
SMTP_USER=noreply@some-domain.com
SMTP_PASSWORD=CHANGE_ME

# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=https://...@sentry.io/...

# MONITORING
PROMETHEUS_METRICS=true
JAEGER_ENABLED=true

# CORS
CORS_ORIGINS=https://somedomain.com,https://api.somedomain.com