# Приложение
APP_NAME=MedLab OCR API
API_VERSION=1.0.0
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# FILE UPLOAD
MAX_FILE_SIZE_MB=50
UPLOAD_DIRECTORY=./uploads
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,csv,xlsx,xls

# OCR SERVICE
OCR_TIMEOUT_SECONDS=30
OCR_RETRY_ATTEMPTS=2
OCR_RETRY_DELAY=0.5
OCR_LANGUAGE_PACK=rus+eng

